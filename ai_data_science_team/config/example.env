# AI Data Science Team - Environment Configuration
# Copy this file to .env in the project root and fill in your values

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Provider: openai, ollama, anthropic, azure, google, or custom
LLM_PROVIDER=openai

# Model name (provider-specific)
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Ollama: llama2, llama3, mistral, mixtral, phi, codellama, deepseek-coder
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Azure: Same as OpenAI models
# Google: gemini-pro, gemini-pro-vision
LLM_MODEL=gpt-4o-mini

# ============================================================================
# API Keys
# ============================================================================

# OpenAI API Key (for provider=openai)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for provider=anthropic)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Azure OpenAI (for provider=azure)
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Google API Key (for provider=google)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Custom/Generic API Key (for provider=custom)
LLM_API_KEY=your-custom-api-key-here

# ============================================================================
# Endpoint Configuration
# ============================================================================

# Base URL for Ollama or custom endpoints
# Ollama default: http://localhost:11434
# Custom: Your OpenAI-compatible API endpoint
LLM_BASE_URL=http://localhost:11434

# ============================================================================
# Model Parameters
# ============================================================================

# Temperature (0.0 - 1.0): Lower = more deterministic, Higher = more creative
LLM_TEMPERATURE=0.7

# Maximum tokens to generate (optional)
# LLM_MAX_TOKENS=4096

# ============================================================================
# Example Configurations
# ============================================================================

# --- OpenAI (GPT-4) ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# LLM_TEMPERATURE=0.7

# --- Ollama (Local Llama2) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# LLM_BASE_URL=http://localhost:11434
# LLM_TEMPERATURE=0.7

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_TEMPERATURE=0.7

# --- Azure OpenAI ---
# LLM_PROVIDER=azure
# LLM_MODEL=gpt-4o-mini
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# LLM_TEMPERATURE=0.7

# --- Custom Endpoint (e.g., vLLM, LiteLLM) ---
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
# LLM_BASE_URL=https://api.internal.com/v1
# LLM_API_KEY=your-key
# LLM_TEMPERATURE=0.7
